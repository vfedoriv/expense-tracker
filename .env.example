# Copy this file to .env and fill in your values.
#
# Spring properties use dot notation (spring.security.oauth2...).
# Vite variables must keep the VITE_ prefix.
#
# Default (no .env file): fake auth mode, local DB — nothing to configure.

# ── Auth mode ─────────────────────────────────────────────────────────────────
app.auth.fake=false
VITE_FAKE_AUTH=false

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com/ → APIs & Services → Credentials
# Redirect URI: http://localhost:8080/login/oauth2/code/google
spring.security.oauth2.client.registration.google.client-id=your-google-client-id
spring.security.oauth2.client.registration.google.client-secret=your-google-client-secret
spring.security.oauth2.client.registration.google.scope=openid,profile,email

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL: http://localhost:8080/login/oauth2/code/github
spring.security.oauth2.client.registration.github.client-id=your-github-client-id
spring.security.oauth2.client.registration.github.client-secret=your-github-client-secret
spring.security.oauth2.client.registration.github.scope=user:email,read:user

# ── Database (override only if not using docker compose defaults) ─────────────
#db.host=localhost
#db.port=5432
#db.name=expensetracker
#db.username=expensetracker
#db.password=expensetracker
