# Copy this file to .env and fill in your values.
# All variable names use uppercase — valid for both Docker Compose and Spring Boot.
# Default (no .env file): fake auth mode, local DB — nothing to configure.

# ── Auth mode ─────────────────────────────────────────────────────────────────
APP_AUTH_FAKE=false
VITE_FAKE_AUTH=false

# ── App base URL (where users access the frontend) ────────────────────────────
APP_BASE_URL=http://localhost:3000

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── GitHub OAuth2 ─────────────────────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL: http://localhost:3000/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── Database (optional, defaults work with docker compose) ────────────────────
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=expensetracker
#DB_USERNAME=expensetracker
#DB_PASSWORD=expensetracker
