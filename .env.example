# Copy this file to .env and fill in your values.
#
# By default (APP_AUTH_FAKE=true) the app runs in demo mode:
#   - no OAuth credentials needed
#   - login screen uses fake SSO buttons
#
# Set APP_AUTH_FAKE=false and provide real OAuth credentials to enable
# Google / GitHub login.

# ── Auth ──────────────────────────────────────────────────────────────────────
APP_AUTH_FAKE=true

# Shown in the browser login page (set to false when using real OAuth)
VITE_FAKE_AUTH=true

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com/ → APIs & Services → Credentials
# Redirect URI: http://localhost:8080/login/oauth2/code/google
#SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=your-google-client-id
#SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=your-google-client-secret
#SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_SCOPE=openid,profile,email

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL: http://localhost:8080/login/oauth2/code/github
#SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_ID=your-github-client-id
#SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_SECRET=your-github-client-secret
#SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_SCOPE=user:email,read:user

# ── Database (override only if not using docker compose defaults) ─────────────
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=expensetracker
#DB_USERNAME=expensetracker
#DB_PASSWORD=expensetracker
